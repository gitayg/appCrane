# Variable NAMES this app reads. No values here, ever.
# AppCrane injects every one of these; set your own with appcrane_set_secret.
# (Named env.example, not .env.example: AppCrane refuses .env* files in a push.)

# Injected by AppCrane
PORT=
DATA_DIR=
APPCRANE_IDENTITY_SECRET=
DATABASE_URL=

# Injected when the app's LLM gateway is enabled
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# Local development only (test/db.test.js)
TEST_DATABASE_URL=
