{
  "name": "appcrane",
  "version": "2.137.1",
  "engines": {
    "node": ">=22"
  },
  "description": "AppCrane - Self-service app hosting and deployment.",
  "license": "AGPL-3.0-only",
  "private": true,
  "homepage": "https://github.com/gitayg/appCrane#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitayg/appCrane.git"
  },
  "bugs": {
    "url": "https://github.com/gitayg/appCrane/issues"
  },
  "type": "module",
  "bin": {
    "crane": "./bin/deployhub.js",
    "appcrane": "./bin/deployhub.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-timeout=120000 test/*.test.js packages/tenant/*.test.js",
    "test:serial": "node --test --test-concurrency=1 --test-timeout=300000 test/serial/*.test.js",
    "gen:mcp-snapshot": "node scripts/gen-mcp-snapshot.mjs",
    "gen:plugin-releases": "node scripts/gen-plugin-releases.mjs"
  },
  "overrides": {
    "follow-redirects": "^1.16.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1165.0",
    "@node-saml/node-saml": "^5.2.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.11.1",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "psl": "^1.15.0"
  }
}
