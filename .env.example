# DeployHub Configuration
PORT=5001
HOST=0.0.0.0

# Encryption key for env vars (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=deployhub@example.com

# AppCrane's own domain (for Caddyfile generation)
CRANE_DOMAIN=crane.example.com

# Base domain for managed apps
BASE_DOMAIN=example.com

# Personal API keys (dhk_user_* / dhk_admin_*) on a private HTTPS port only.
# Set, Caddy adds CRANE_DOMAIN:<port> (same certificate, AppCrane only) and those
# keys are refused (403 USER_KEY_PRIVATE_PORT_ONLY) on 443 and every app host.
# Sessions, SSO, MCP keys/OAuth, Crew tokens and webhooks stay on 443. Open this
# port to your SDP/VPN only, and keep PORT closed to the outside: requests that
# reach PORT directly are not refused. Remote CLI: crane config --url https://your-crane-host:8443
# Unset = no private port, keys work on 443 as before.
# APPCRANE_PRIVATE_API_PORT=8443

# Caddy admin API (Linux only)
CADDY_ADMIN_URL=http://localhost:2019
# Caddy's redacted access log (rotated 50 MiB x 5). Used only when its directory exists.
# CADDY_ACCESS_LOG_FILE=/var/log/caddy/access.log

# Data directory
DATA_DIR=./data

# ── Optional hardening switches (unset = lenient default) ──────────────────
# Both follow the same shape on purpose: ship permissive so an upgrade cannot
# break a running fleet, then let the operator turn enforcement on once they
# have checked their own estate. Leaving them unset is a deliberate choice, not
# an oversight — but nothing enforces them until you set them.

# Refuse a deploy whose Dockerfile does not declare a non-root USER in its FINAL
# build stage. Default (unset): warn on every deploy instead. Most Dockerfiles
# omit USER, so turning this on before the fleet is clean fails those deploys.
# Sweep first — note that an app on an already-non-root base image (distroless
# :nonroot, nginx-unprivileged) still needs an explicit USER line, because the
# validator cannot inspect base-image metadata.
# APPCRANE_REQUIRE_NONROOT=1

# Fail an MCP tool call when its audit record cannot be written, rather than
# proceeding unaudited. Default (unset): best-effort audit.
# APPCRANE_AUDIT_REQUIRED=1

# ── AWS Secrets Manager (optional; unset = off, and the AWS SDK is never loaded) ──
# Keep AppCrane's own keys out of this file: `crane secrets migrate` moves
# ENCRYPTION_KEY and ANTHROPIC_API_KEY into one secret (a JSON object) and sets
# the lines below. If the secret cannot be read at startup AppCrane exits; it
# never falls back to this file. A key both here and in the secret with a
# different value also stops the boot. Check with `crane secrets status`.
# The secret may hold only ENCRYPTION_KEY, ANTHROPIC_API_KEY, SMTP_PASS,
# GRAPH_CLIENT_SECRET, GITHUB_TOKEN and CATALOG_GITHUB_TOKEN; any other key stops the boot.
# Template with the secret and the instance role's policy: deploy/aws/appcrane-secrets.yaml
# APPCRANE_SECRETS_PROVIDER=aws-secrets-manager
# The platform secret, name or ARN. Optional: without it, app secrets still work.
# APPCRANE_SECRETS_ID=appcrane/platform
# Optional, else AWS_REGION, else the SDK default.
# APPCRANE_SECRETS_REGION=us-east-1
# Where app secrets live: <prefix>/<app namespace>/<env>/<NAME>. An env var can then be
# the reference secretsmanager:<NAME>[#jsonField], resolved at deploy and restart.
# APPCRANE_SECRETS_APP_PREFIX=appcrane/apps
