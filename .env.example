# DeployHub Configuration
PORT=5001
HOST=0.0.0.0

# Encryption key for env vars (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=deployhub@example.com

# AppCrane's own domain (for Caddyfile generation)
CRANE_DOMAIN=crane.example.com

# Base domain for managed apps
BASE_DOMAIN=example.com

# Caddy admin API (Linux only)
CADDY_ADMIN_URL=http://localhost:2019

# Data directory
DATA_DIR=./data

# ── Optional hardening switches (unset = lenient default) ──────────────────
# Both follow the same shape on purpose: ship permissive so an upgrade cannot
# break a running fleet, then let the operator turn enforcement on once they
# have checked their own estate. Leaving them unset is a deliberate choice, not
# an oversight — but nothing enforces them until you set them.

# Refuse a deploy whose Dockerfile does not declare a non-root USER in its FINAL
# build stage. Default (unset): warn on every deploy instead. Most Dockerfiles
# omit USER, so turning this on before the fleet is clean fails those deploys.
# Sweep first — note that an app on an already-non-root base image (distroless
# :nonroot, nginx-unprivileged) still needs an explicit USER line, because the
# validator cannot inspect base-image metadata.
# APPCRANE_REQUIRE_NONROOT=1

# Fail an MCP tool call when its audit record cannot be written, rather than
# proceeding unaudited. Default (unset): best-effort audit.
# APPCRANE_AUDIT_REQUIRED=1
