      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitayg/appCrane.git",
    "directory": "packages/tenant"
  },
  "homepage": "https://github.com/gitayg/appCrane/tree/main/packages/tenant",
  "keywords": [
    "appcrane",
    "multitenancy",
    "multi-tenant",
    "sqlite",
    "tenant",
    "paas"
