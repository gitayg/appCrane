    handle /api/service* {
        respond 404
    }

    handle /a2a* {
        reverse_proxy 127.0.0.1:5001
    }

    handle /git/* {
        reverse_proxy 127.0.0.1:5001
    }

    handle /.well-known/agent-card.json {
        reverse_proxy 127.0.0.1:5001
    }

    handle /oauth/* {
        reverse_proxy 127.0.0.1:5001
    }

    handle /.well-known/oauth-* {
        reverse_proxy 127.0.0.1:5001
    }

    handle {
        encode zstd gzip {
            match {
                header Content-Type text/html*
                header Content-Type text/css*
                header Content-Type text/plain*
                header Content-Type text/javascript*
                header Content-Type application/javascript*
                header Content-Type application/json*
                header Content-Type image/svg+xml*
                header Content-Type application/manifest+json*
            }
        }
        reverse_proxy 127.0.0.1:5001
    }

    handle_errors {
        @appdown expression `{err.status_code} in [502, 503, 504]`
        @cranedown expression `{err.status_code} in [502, 503, 504] && {http.reverse_proxy.upstream.port} == "5001"`
        handle @cranedown {
            header Content-Type "text/html; charset=utf-8"
            header Cache-Control "no-store"
            respond <<APPCRANE_UNAVAILABLE_PAGE
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="appcrane-unavailable" content="Platform">
<meta http-equiv="refresh" content="20">
<title>AppCrane is unavailable</title>
<style>
:root { --bg: #f6f7f9; --card: #ffffff; --line: #e2e5ea; --text: #1b1e24; --muted: #5d6470; --accent: #2563eb; --badge: #eef1f5; }
@media (prefers-color-scheme: dark) { :root { --bg: #0f1117; --card: #1a1d27; --line: #2a2d3a; --text: #e4e4e7; --muted: #a1a1aa; --accent: #3b82f6; --badge: #2a2d3a; } }
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px; background: var(--bg); color: var(--text); font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; }
main { width: 100%; max-width: 480px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 32px 28px; text-align: center; }
h1 { margin: 0 0 6px; font-size: 1.3rem; font-weight: 600; }
.env { display: inline-block; margin-bottom: 14px; padding: 2px 8px; border-radius: 4px; background: var(--badge); color: var(--muted); font-size: .72rem; letter-spacing: .5px; text-transform: uppercase; }
p { margin: 8px 0; color: var(--muted); }
a.btn { display: inline-block; margin-top: 18px; padding: 8px 16px; border-radius: 6px; background: var(--accent); color: #fff; text-decoration: none; font-weight: 500; }
.hint { margin-top: 16px; font-size: .8rem; }
</style>
</head>
<body>
<main>
<h1>AppCrane is unavailable</h1>
<div class="env">Platform</div>
<p>AppCrane is not answering right now, so the apps it serves cannot be opened either.</p>
<p>It is usually back within a minute, for example after a restart or a deploy.</p>
<a class="btn" href="/dashboard">Open the AppCrane dashboard</a>
<p class="hint">This page tries again every 20 seconds. Served by AppCrane.</p>
</main>
</body>
</html>
APPCRANE_UNAVAILABLE_PAGE 503
        }
        handle @appdown {
            rewrite * /api/_crashed{uri}
            reverse_proxy 127.0.0.1:5001
        }
    }
}

shop.example.com {
    header {
        ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
        ?X-Content-Type-Options "nosniff"
        ?Referrer-Policy "strict-origin-when-cross-origin"
        ?X-Permitted-Cross-Domain-Policies "none"
        ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        -X-Powered-By
        -Server
    }
    @brotli_body header_regexp Content-Encoding "(?i)(^|,)\s*br\s*(,|$)"
    handle @brotli_body {
        header Accept-Encoding "gzip, deflate"
        respond "Request bodies compressed with Brotli (Content-Encoding: br) are not accepted." 415
    }
    request_header -X-AppCrane-User
    request_header -X-AppCrane-User-Id
    request_header -X-AppCrane-User-Email
    request_header -X-AppCrane-User-Name
    request_header -X-AppCrane-User-Role
    request_header -X-AppCrane-App-Role
    request_header -X-AppCrane-Is-Admin
    request_header -X-AppCrane-App-Roles
    request_header -X-AppCrane-Identity-Ts
    request_header -X-AppCrane-Identity-Sig
    request_header -X-AppCrane-Identity-Sig-V2
    request_header -X-AppCrane-Auth-Via
    request_header -X-AppCrane-Auth-Time
    request_header -X-AppCrane-Auth-Mfa
    request_header -X-AppCrane-Identity-Sig-V3
    request_header -X-AppCrane-Auth-Mode
    request_header X-AppCrane-Auth-Mode "bypass"
    request_header Cookie "(^|;\s*)cc_token=[^;]*" ""
    request_header Cookie "^;\s*" ""
    reverse_proxy 127.0.0.1:4007
    handle_errors {
        @appdown expression `{err.status_code} in [502, 503, 504]`
        handle @appdown {
            header Content-Type "text/html; charset=utf-8"
            header Cache-Control "no-store"
            respond <<APPCRANE_UNAVAILABLE_PAGE
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
