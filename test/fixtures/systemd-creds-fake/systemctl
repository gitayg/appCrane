#!/usr/bin/env node
// A stand-in for systemctl in test/secrets-provider-systemd-creds.test.js.
// FAKE_SYSTEMCTL_ACTIVE=1 makes the unit active; FAKE_SYSTEMCTL_LOADSTATE sets
// LoadState; FAKE_SYSTEMCTL_RELOAD_FAIL=1 fails daemon-reload. DropInPaths lists
// $FAKE_SYSTEMCTL_DROPIN_DIR/credentials.conf when that file exists.
import { appendFileSync, existsSync } from 'fs';
import { join } from 'path';

const args = process.argv.slice(2);
if (process.env.FAKE_SYSTEMD_LOG) appendFileSync(process.env.FAKE_SYSTEMD_LOG, `${JSON.stringify(['systemctl', ...args])}\n`);
const env = process.env;
if (args[0] === 'daemon-reload') process.exit(env.FAKE_SYSTEMCTL_RELOAD_FAIL ? 1 : 0);
if (args[0] === 'is-active') process.exit(env.FAKE_SYSTEMCTL_ACTIVE === '1' ? 0 : 3);
if (args[0] === 'show') {
  const prop = args[args.indexOf('-p') + 1];
  if (prop === 'LoadState') console.log(env.FAKE_SYSTEMCTL_LOADSTATE || 'loaded');
  else if (prop === 'DropInPaths') {
    const f = env.FAKE_SYSTEMCTL_DROPIN_DIR ? join(env.FAKE_SYSTEMCTL_DROPIN_DIR, 'credentials.conf') : null;
    console.log(f && existsSync(f) ? f : '');
  } else console.log('');
  process.exit(0);
}
console.error(`fake systemctl: unsupported ${args.join(' ')}`);
process.exit(2);
