# Shared secret between this app and the Nesher agent. Generate with: openssl rand -hex 32
AGENT_TOKEN=
# Public address phones/PCs connect to. Use a dynamic-DNS name if Nesher's home IP changes.
# Leave empty to use the IP the agent checks in from.
VPN_ENDPOINT=
VPN_PORT=51820
VPN_DNS=1.1.1.1, 1.0.0.1
MAX_TTL_HOURS=168
MAX_PASSES_PER_USER=5
