# engine-strict is the ONLY Node floor guard that works across a version jump.
#
# v2.51.0 taught self-update to upgrade the runtime — but the updater that runs
# is always the code you are upgrading FROM, never the code you are upgrading
# TO. A host on an older release that jumps straight to a version whose
# dependencies need Node 22 executes its OWN updater, which knows nothing about
# any of this, and installs them anyway. The check protected only hosts that had
# already taken it.
#
# This file does not have that problem. `git reset --hard origin/main` brings it
# into the working tree BEFORE `npm install` runs, so every updater — including
# ones written before the floor existed — reads it. Measured on the real
# dependency tree: Node 20 fails with `notsup ... Required: {"node":">=22"}` and
# creates no node_modules; Node 22 installs clean.
#
# `engines` alone does NOT do this. Also measured: with engines >=22 and no
# engine-strict, `npm install` on Node 20 exits 0 and installs the package
# regardless. The declaration is advisory; this is what enforces it.
#
# The failure is the safe one. npm exits non-zero, the updater's execFileSync
# throws, self-update aborts, and the rollback sentinel restores the previous
# SHA — the host keeps running the release it was already serving, rather than
# starting one whose native modules were built for a runtime it does not have.
engine-strict=true
